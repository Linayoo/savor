{
  "cli": {
    "version": "27.5.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "node": "24.22.1",
      "pnpm": "11.28.8",
      "ios": {
        "image": "latest"
      }
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "APP_VARIANT": "development"
      }
    },
    "production": {
      "extends": "base",
      "distribution": "store",
      "environment": "production",
      "autoIncrement": true,
      "env": {
        "APP_VARIANT": "production"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6832479165",
        "groups": ["Internal"]
      }
    }
  }
}
