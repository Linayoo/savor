# Copy to .env (gitignored). Values come from the Terraform outputs in
# infra/app; none are secrets.
# terraform -chdir=infra/app output -raw api_url
EXPO_PUBLIC_API_URL=
# terraform -chdir=infra/app output -raw user_pool_id
EXPO_PUBLIC_USER_POOL_ID=
# terraform -chdir=infra/app output -raw client_id
EXPO_PUBLIC_USER_POOL_CLIENT_ID=
