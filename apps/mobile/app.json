{
  "expo": {
    "name": "savor",
    "slug": "savor",
    "version": "1.0.0",
    "platforms": ["ios", "android"],
    "orientation": "portrait",
    "icon": "./assets/icon/savor-icon.png",
    "scheme": "savor",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.linayoo.savor",
      "icon": {
        "light": "./assets/icon/savor-icon.png",
        "dark": "./assets/icon/savor-icon-dark.png",
        "tinted": "./assets/icon/savor-icon-tinted.png"
      }
    },
    "android": {
      "package": "com.linayoo.savor",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F6F1E8",
          "image": "./assets/icon/savor-splash.png",
          "imageWidth": 72
        }
      ],
      "expo-font",
      "expo-status-bar",
      "expo-sqlite",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
