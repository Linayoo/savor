{
  "name": "@savor/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./router": {
      "types": "./src/router.ts"
    }
  },
  "scripts": {
    "dev": "NODE_ENV=development tsx watch src/dev.ts",
    "build": "tsx scripts/build.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "smoke": "tsx scripts/smoke.ts",
    "photo-checks": "tsx scripts/photo-checks.ts",
    "tagging-check": "tsx scripts/tagging-check.ts",
    "letter-preview": "tsx scripts/letter-preview.ts",
    "seed-moments": "tsx scripts/seed-moments.ts"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1161.0",
    "@aws-sdk/client-s3": "^3.1161.0",
    "@aws-sdk/client-secrets-manager": "^3.1161.0",
    "@aws-sdk/s3-presigned-post": "^3.1161.0",
    "@aws-sdk/s3-request-presigner": "^3.1161.0",
    "@neondatabase/serverless": "^1.2.0",
    "@savor/shared": "workspace:*",
    "@trpc/server": "^11.19.0",
    "drizzle-orm": "~0.45.4",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1161.0",
    "@eslint/js": "^9.39.5",
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "~0.31.11",
    "esbuild": "~0.28.2",
    "eslint": "^9.39.5",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "~8.72.0",
    "vitest": "^5.0.5"
  }
}
